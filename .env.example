# Docker host / Minecraft settings
TZ=Asia/Tokyo
MINECRAFT_PORT=25565
BEDROCK_PORT=19132
MINECRAFT_MEMORY=2G
CONTAINER_MEMORY_LIMIT=3G

# Server settings
SERVER_NAME=Minecraft Platform Lab
MOTD=Minecraft Platform Engineering Lab
DIFFICULTY=easy
GAME_MODE=survival
MAX_PLAYERS=5
VIEW_DISTANCE=6
SIMULATION_DISTANCE=4
PVP=true

# Internal RCON only. Do not expose TCP/25575 on the host.
# Change this value before starting the server.
RCON_PASSWORD=change-me-before-start
